<div class="dxbl-upload-container custom-upload-container">
    <div class="dxbl-upload-file-list-view" aria-live="polite">
        @foreach (var entry in Entries)
        {
            var state = entry.State();

            <div class="dxbl-upload-file-view">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Text"
                          CssClass="dxbl-upload-file-btn"
                          role="presentation">
                    <DxIcon Type="uc-file" />
                </DxButton>

                <div class="dxbl-upload-file-view-details">
                    <div class="dxbl-upload-file-view-info">
                        <span class="dxbl-upload-file-view-text">@entry.Name</span>
                        <span class="dxbl-upload-file-view-size">@FormatBytes(entry.Size)</span>
                        <span class="dxbl-upload-file-view-size">@entry.Guid</span>
                        <span class="dxbl-upload-file-view-size">@entry.SelectedFile?.Guid</span>
                    </div>

                    @switch (state)
                    {
                        case UploadState.NotStarted:
                            <span class="dxbl-upload-file-view-load-state">Ready to upload</span>
                            break;

                        case UploadState.InProgress:
                            <DxProgressBar Value="entry.BytesRead" MaxValue="entry.Size" ShowLabel="false" Size="100%" CssClass="dxbl-upload-file-view-progress-bar" />
                            break;

                        case UploadState.Error:
                            <span class="dxbl-upload-file-view-load-state dxbl-upload-file-view-invalid-load-state">@(entry.ErrorMessage ?? "Error")</span>
                            break;

                        case UploadState.Success:
                            <span class="dxbl-upload-file-view-load-state dxbl-upload-file-view-success-load-state">Uploaded</span>
                            break;
                    }
                </div>
                <div class="dxbl-upload-file-view-icon-container">
                    @switch (state)
                    {
                        case UploadState.NotStarted:
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      CssClass="dxbl-upload-upload-btn"
                                      Click="() => UploadFile(entry)">
                                <DxIcon Type="uc-upload" />
                            </DxButton>
                            break;
                        case UploadState.Error:
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      CssClass="dxbl-upload-reload-btn"
                                      Click="() => ReloadFile(entry)">
                                <DxIcon Type="uc-reload" />
                            </DxButton>
                            break;
                    }
                    @switch (state)
                    {
                        case UploadState.InProgress:
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      CssClass="dxbl-upload-cancel-btn"
                                      Click="() => CancelFile(entry)">
                                <DxIcon Type="cancel" />
                            </DxButton>
                            break;
                        default:
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      CssClass="dxbl-upload-cancel-btn"
                                      Click="() => RemoveFile(entry)">
                                <DxIcon Type="cancel" />
                            </DxButton>
                            break;
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<FileInputListEntry> Entries { get; set; } = Enumerable.Empty<FileInputListEntry>();

    [CascadingParameter]
    public required DxFileInput FileInput { get; set; }

    private static string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "kB", "MB", "GB", "TB", "PB", "EB" };

        if (bytes < 0)
            return "(0 B)";

        double size = bytes;
        int order = 0;

        while (size >= 1024 && order < suffixes.Length - 1)
        {
            size /= 1024;
            order++;
        }

        long truncated = (long)size;

        return $"({truncated} {suffixes[order]})";
    }

    private void UploadFile(FileInputListEntry entry)
    {
        FileInput.UploadFile(entry.UploadInfo);
    }

    private void ReloadFile(FileInputListEntry entry)
    {
        entry.ErrorMessage = null;
        FileInput.ReloadFile(entry.UploadInfo);
    }

    private void CancelFile(FileInputListEntry entry)
    {
        FileInput.CancelFileUpload(entry.UploadInfo);
    }

    private void RemoveFile(FileInputListEntry entry)
    {
        FileInput.CancelFileUpload(entry.UploadInfo);
        FileInput.RemoveFile(entry.UploadInfo);
    }
}
