@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IFileVersionProvider FileVersionProvider

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @DxResourceManager.RegisterTheme(ActiveTheme)
    @DxResourceManager.RegisterScripts()
    <link href=@AppendVersion("css/site.css") rel="stylesheet" />
    <link href=@AppendVersion("DxFileInput.CustomErrorMessage.styles.css") rel="stylesheet" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    static readonly ITheme FluentTheme = Themes.Fluent.Clone(properties =>
    {
        properties.Mode = ThemeMode.Light;
    });

    static readonly ITheme BootstrapTheme = Themes.BootstrapExternal.Clone(properties =>
    {
        properties.AddFilePaths(["css/bootstrap/bootstrap.min.css"]);
    });

    static readonly ITheme ActiveTheme = FluentTheme;

    private string AppendVersion(string path) => FileVersionProvider.AddFileVersionToPath("/", path);
}
